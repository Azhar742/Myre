# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Flask Secret Key (generate a random string for production)
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# For local development with SQLite, comment out or remove DATABASE_URL
# For production with Supabase PostgreSQL, uncomment and add your connection string:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# Example Supabase connection string format:
# DATABASE_URL=postgresql://postgres:your_password@db.abcdefghijklmnop.supabase.co:5432/postgres

# Note: Never commit your .env file to git!
# Make sure .env is listed in .gitignore
